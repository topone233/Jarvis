{
  "name": "jarvis-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint src",
    "format": "prettier --write src index.html vite.config.ts",
    "format:check": "prettier --check src index.html vite.config.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "mermaid": "12.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "react-router": "8.3.1",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "oxlint": "1.82.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
